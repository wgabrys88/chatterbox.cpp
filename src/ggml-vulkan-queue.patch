+#if defined(_WIN32)
+#define GGML_VK_OVERLAP_EXPORT __declspec(dllexport)
+#else
+#define GGML_VK_OVERLAP_EXPORT
+#endif
+extern "C" GGML_VK_OVERLAP_EXPORT void ggml_vk_overlap_counters(ggml_backend_t b, unsigned long long * wait_us,
+                                                          unsigned long long * submit_n, unsigned long long * barrier_n, int reset) {
+    unsigned long long w = 0, s = 0, br = 0;
+    if (b && ggml_backend_is_vk(b)) {
+        ggml_backend_vk_context * ctx = (ggml_backend_vk_context *)b->context;
+        w = ctx->wait_us;
+        s = ctx->submit_n;
+        br = ctx->barrier_n;
+        if (reset) {
+            ctx->wait_us = 0;
+            ctx->submit_n = 0;
+            ctx->barrier_n = 0;
+        }
+    }
+    if (wait_us) {
+        *wait_us = w;
+    }
+    if (submit_n) {
+        *submit_n = s;
+    }
+    if (barrier_n) {
+        *barrier_n = br;
+    }
+}
